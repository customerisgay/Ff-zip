# ======================================================================
#  ffbot-render - environment file
#
#  Only ONE value must be filled for Render:  BOT_TOKEN
#  LOOKUP_URL / API_PUBLIC_URL / DATABASE_URL are injected by render.yaml,
#  so there is no Free Fire URL for you to find.
#
#  Keep comments on their OWN line: python-dotenv treats anything after a
#  value as part of that value.
#  NEVER commit this file.
# ======================================================================

# ---------------- Telegram bot ----------------
BOT_TOKEN=8656349874:AAHUSOJUAYjRv359MG689uCV933V6jgTPbM
ADMIN_IDS=8581890404,8725461956
FORCE_JOIN_CHAT=@bomberjantaparty
HEALTH_SERVER=1

# ---------------- Database ----------------
# Empty = local SQLite file (development only). Render always sets this.
DATABASE_URL=
DB_PATH=ffbot.db

# ---------------- Free Fire data source ----------------
# Leave EMPTY on Render: render.yaml wires it from the ff-source service.
# For local runs use the bare host, e.g. 127.0.0.1:8080  (scheme and the
# players path are added automatically).
LOOKUP_URL=
UPSTREAM_KEY=
DEFAULT_REGION=IND
HTTP_TIMEOUT=30

# ---------------- Public API address ----------------
# Leave EMPTY on Render (wired from the ff-api service).
# Local example: 127.0.0.1:8090
API_PUBLIC_URL=
API_BRAND=Bomber Janta Party Free Fire API
API_OWNER=@bomberjantaparty

# ---------------- Garena guest credentials ----------------
# Used ONLY by the ff-source container. Paste these same two values into the
# ff-source environment on Render.
FREEFIRE_PROTOCOL=OB55
FREEFIRE_DEFAULT_REGION=IND
FREEFIRE_DEFAULT_UID=5466935505
FREEFIRE_DEFAULT_PASSWORD=4C688C2649082347FDC06815AAA5BB0E9BB69AFAFC1CF5F6ACCABE93A3DEBB27
FREEFIRE_ENABLED=true
FREEFIRE_ROUTES_ENABLED=true
FREEFIRE_MEDIA_ENABLED=true
